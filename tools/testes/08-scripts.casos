### script-read-stdin [script stdin="Ana\n29\n"]
read -p "Nome: " nome
read idade
echo "$nome tem $idade"
read x
echo "status $?"
### script-read-ifs [script stdin="a b c d\n  x  y  \nu,v,w\n"]
read p q
echo "[$p] [$q]"
read l
echo "[$l]"
IFS=, read -r m n
echo "[$m] [$n]"
### script-read-backslash [script stdin="a\\\\b c\\\\\nd\n"]
read x
echo "[$x]"
### script-getopts [script args="-a -b valor -c arq1 arq2"]
while getopts "ab:c" op; do
  case $op in
    a) echo "a";;
    b) echo "b=$OPTARG";;
    c) echo "c";;
    ?) echo "erro";;
  esac
done
shift $((OPTIND-1))
echo "resto: $@"
### script-getopts-erros [script args="-x -b"]
while getopts "ab:" op; do echo "op=$op arg=${OPTARG-}"; done
while getopts ":ab:" op; do echo "op=$op arg=${OPTARG-}"; done
### script-select [script stdin="2\n9\n1\n"]
PS3="Escolha: "
select f in maçã pera uva; do
  echo "[$f] [$REPLY]"
  [ -n "$f" ] && break
done
### script-eval [script]
x='echo dentro do eval'
eval $x
eval 'y=5'; echo $y
eval 'if'
echo depois
### script-source [script]
echo 'v=fonte; echo "no source: $1"' > /tmp/s.sh
source /tmp/s.sh arg
echo $v
. /tmp/nada.sh
echo $?
### script-shebang-exec [script]
printf '#!/bin/bash\necho executou $1\n' > /tmp/x.sh
/tmp/x.sh a
chmod +x /tmp/x.sh
/tmp/x.sh b
mkdir /tmp/d; /tmp/d
echo $?
### script-bash-c [script]
bash -c 'echo $0 $1' meu arg
bash -c 'exit 4'; echo $?
bash -c 'xyz'
bash -c 'if'
bash -n /dev/null; echo $?
