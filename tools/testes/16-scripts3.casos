### source-bash-source [script]
printf 'echo "BASH_SOURCE=${BASH_SOURCE[0]} 0=$0"\n' > /tmp/b.sh
source /tmp/b.sh
echo "${BASH_SOURCE[0]}"
### read-opcoes [script stdin="abc\ndef\nghi\n"]
read -u 0 a; echo "[$a]"
read -t 1 b; echo "[$b] $?"
read -e c; echo "[$c]"
read -i padrao d; echo "[$d] $?"
### read-delim-vazio [script]
printf 'a b\0c d\0' | while IFS= read -r -d '' x; do echo "[$x]"; done
### mapfile-pipe-lastpipe [script]
shopt -s lastpipe
printf '1\n2\n' | mapfile -t arr
echo "${#arr[@]}"
