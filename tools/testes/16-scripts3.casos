### cond-v-arrays [script]
a=(x y); declare -A m=([k]=1)
[[ -v a[1] ]] && echo a1; [[ -v a[5] ]] || echo sem-a5
[[ -v m[k] ]] && echo mk; [[ -v m[z] ]] || echo sem-mz
[[ -v nada ]] || echo sem-nada
### declare-p-varios [script]
declare -n ref=alvo; alvo=1; declare -p ref
f() { echo oi; }; declare -p f 2>&1; declare -pf f
declare -A m=([a b]=1 ["x\"y"]=2); declare -p m
declare -x -i n=3; declare -p n
### printf-v-assoc [script]
declare -A m; printf -v 'm[x]' '%d' 42; echo ${m[x]}
### procsub-paste [script]
