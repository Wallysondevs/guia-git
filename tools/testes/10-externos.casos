mkdir -v d1 d2
mkdir d1
mkdir x/y
mkdir -p x/y; ls -R x
cp a d1/; ls d1
cp -v b c
cp d1 d3
cp -r d1 d3; ls d3
mv c d1/; ls d1
mv -v a z
rm z; ls
rm d1
rm -r d1 d3; ls
rmdir d2 x
rmdir nada
rm nada
rm -f nada; echo $?
rm -f; echo $?
ln -s b lb; ls -l lb | cut -c1-10
ln -s b lb
cat lb
chmod 600 b; stat -c '%a %A' b
chmod u+x,g=r b; stat -c '%a' b
chmod -v 644 b
chmod xyz b
touch -d '2026-01-02 03:04' b; stat -c '%y' b
