basename /a/b/arq.txt
basename /a/b/arq.txt .txt
basename -s .txt a.txt b.txt
dirname /a/b/arq.txt
dirname arq.txt
dirname /
realpath Documentos/../frutas.txt
realpath -m /x/y/../z
readlink -f /bin/sh
basename
### seq-expr-bc
seq 3
seq 2 5
seq 1 2 9
seq -s, 5
seq -w 8 11
seq 0.5 0.5 2
seq 5 -1 3
expr 2 + 3
expr 10 / 3
expr 5 \* 3
expr length banana
expr substr banana 2 3
expr index banana n
expr banana : 'ban\(.*\)'
expr 1 +
expr a + 1
expr 3 \> 2
expr 0 + 0; echo $?
echo '1+2*3' | bc
echo 'scale=2; 10/3' | bc
echo 'scale=2; (9.5+7.0+8.5)/3' | bc
echo '2^10; sqrt(16); 5%3' | bc
echo '-0.5 + 0.25' | bc
echo 'x=3; x*x' | bc
bc <<< 'scale=3; 1/7'
echo '1/0' | bc
