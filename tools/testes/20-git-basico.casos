### rm-mv-ignore-merge-tag
mkdir r && cd r && git init -q
printf 'a\nb\nc\n' > f.txt; mkdir dir; echo x > dir/x.txt; echo y > dir/y.txt
git add . && git commit -q -m inicial
git rm f.txt
git status
git status -s
git commit -q -m rm
git mv dir/x.txt dir/z.txt
git status
git commit -m mv
rm dir/y.txt
git status
git add -A; git commit -q -m del
mkdir novo; echo 1 > novo/a; echo 2 > novo/b
git status
git status --short
echo '*.log' > .gitignore; echo oi > app.log
git status -s
git status --ignored
git check-ignore -v app.log
git add app.log
git switch -c feature
echo F > feature.txt; git add feature.txt; git commit -q -m 'feature'
git switch main
echo M > main.txt; git add main.txt; git commit -q -m 'main'
git merge feature -m 'Merge feature'
git log --oneline --graph
git log --oneline --graph --all
git branch -v
git branch -a
git tag v1.0
git tag -a v2.0 -m 'Versão 2'
git tag
git show v2.0
git log --oneline --decorate -3
git log --oneline -3
