### atribuicao
x=1; echo $x
x = 1
echo $?
cidade=Porto Alegre
echo "[$cidade]"
y="Porto Alegre"; echo $y
a=1 b=2; echo $a$b
### escopo-funcao
f() { local x=dentro; y=global; echo $x; }
x=fora; f; echo $x $y
g() { echo $z; }; h() { local z=dinamico; g; }; h
### local-fora
local x=1
echo $?
### export
export A=1
bash -c 'echo $A'
B=2; bash -c 'echo [$B]'
export -n A; bash -c 'echo [$A]'
C=3 bash -c 'echo $C'; echo [$C]
### declare-varios
declare -i n=5; n+=2; echo $n
n="3*4"; echo $n
declare -l m=ABC; echo $m
declare -u u=abc; echo $u
declare -r R=1; R=2; echo $R
declare -p n m u R
declare -p nada
x=1; unset x; declare -p x
declare z; declare -p z
### readonly
readonly PI=3.14
PI=3
echo $?
unset PI
readonly -p | grep 'PI='
### unset
x=1; unset x; echo "[$x]"
f() { :; }; unset -f f; type f
arr=(a b c); unset 'arr[1]'; echo ${arr[@]} ${#arr[@]} ${!arr[@]}
### especiais
echo $0
set -- a b c; echo $# $1 $3 ${10} "${@:2}"
echo $?
false; echo $?
echo $BASH_VERSION
echo ${BASH_VERSINFO[0]} ${BASH_VERSINFO[1]}
echo $HOME $USER $PWD
echo $SHELL
echo $HOSTNAME
echo $UID $EUID
echo $LINENO
echo $_ 
### random-semente
RANDOM=42; echo $RANDOM $RANDOM $RANDOM
RANDOM=1; echo $RANDOM
### nounset
set -u
echo $nada
echo depois
echo ${nada:-ok}
set +u
### nameref
declare -n r=alvo
alvo=1; echo $r
r=2; echo $alvo
declare -p r
f() { local -n ref=$1; ref=mudou; }; v=x; f v; echo $v
### shift-posicionais
set -- a b c d
shift; echo $@
shift 2; echo $@
shift 5; echo $? $@
set -- "${@}" e f; echo $#
